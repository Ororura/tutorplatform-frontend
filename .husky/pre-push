#!/bin/sh

set -e

echo "Running pre-push checks..."

echo "1/6 TypeScript"
npm run typecheck

echo "2/6 Prettier"
npm run format:check

echo "3/6 Tailwind CSS"
npm run lint:tailwind

echo "4/6 ESLint"
npm run lint

echo "5/6 Unit tests"
npm run test

echo "6/6 Production build"
npm run build

echo "All pre-push checks passed."
